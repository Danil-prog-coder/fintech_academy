DATABASE_URL=postgresql+asyncpg://resheno:resheno@postgres:5432/resheno
SECRET_KEY=change-me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Authorization key из кабинета GigaChat (base64 от client_id:client_secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
# Размерность должна совпадать с моделью эмбеддингов
GIGACHAT_EMBEDDINGS_DIM=1024
# Путь к сертификату российского УЦ, если TLS не проходит
GIGACHAT_CA_BUNDLE=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
LLM_PRIMARY=gigachat
LLM_FALLBACK=yandex
EMBEDDINGS_PROVIDER=gigachat
LLM_TIMEOUT_SEC=30

GITHUB_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
MAX_REPO_FILES=1000000
MAX_FILE_BYTES=1000000000
LOG_LEVEL=INFO

# GigaChat (https://developers.sber.ru/docs/ru/gigachat/api/overview)
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.crt
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
# true — проверять TLS-сертификат GigaChat; отключать (false) только для
# локальной отладки без российского CA-бандла
GIGACHAT_VERIFY_SSL=true