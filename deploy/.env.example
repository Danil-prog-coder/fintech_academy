# Скопируйте в .env в корне репозитория:  cp deploy/.env.example .env
# Тогда обычный `docker compose up -d --build` сразу поднимает продакшен-вариант с HTTPS.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Домены сайтов. Без своего домена подойдёт sslip.io: admin.<IP через дефисы>.sslip.io
ADMIN_DOMAIN=admin.201-51-2-36.sslip.io
MAIL_DOMAIN=mail.201-51-2-36.sslip.io

# Пароли баз (наружу базы не публикуются, но дефолтные admin/mail/rag лучше заменить).
# Сгенерировать: openssl rand -hex 24
ADMIN_DB_PASSWORD=
MAIL_DB_PASSWORD=
RAG_DB_PASSWORD=
