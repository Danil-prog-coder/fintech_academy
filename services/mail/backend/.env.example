# --- mail: демо-интеграция платформы (почтовый клиент IMAP/SMTP со своими пользователями) ---
# В docker compose DATABASE_URL задаётся автоматически.
# DATABASE_URL=postgresql+asyncpg://mail:mail@localhost:5432/mail

# Подпись JWT пользователей почты (≥ 32 символов) и ключ Fernet для паролей ящиков.
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<сгенерируйте>
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<сгенерируйте>

# Платформа: адрес admin во внутренней сети и ключ интеграции (тот же, что в BOOTSTRAP_INTEGRATIONS у admin)
PLATFORM_URL=http://admin:8000
PLATFORM_API_KEY=<ключ интеграции mail-demo>
EVENTS_POLL_SEC=5

# Почтовые серверы: подключаться к приватным адресам можно только в разработке (иначе SSRF)
MAIL_ALLOW_PRIVATE_HOSTS=false
