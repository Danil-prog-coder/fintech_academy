# --- LLM (OpenAI-совместимый API). Провайдер основного чата: openrouter | gemini | openai ---
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# ключ OpenRouter (sk-or-…): без него не работают ни ответы ассистента, ни индексация документов
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# если LLM_PROVIDER=openai/gemini — ключ основного провайдера (модель с префиксом «gemini/» идёт в GEMINI_API_KEY)
LLM_API_KEY=
GEMINI_API_KEY=

# --- маршрутизация моделей (rag_service/agent/router.py) ---
# простой вопрос (без скриншота, короткий, не процедура/таблица/сравнение/цифры регламента, поиск нашёл один
# уверенный фрагмент) → быстрый уровень; всё остальное и любое сомнение → тяжёлый. Проверки цитат и чисел — на обоих.
# «модель@Провайдер» закрепляет провайдера OpenRouter (only, sort=throughput, без автозамены); следующая — запасная.
ROUTING_ENABLED=true
FAST_MODEL=deepseek/deepseek-v4.1-flash-1017@Baseten,deepseek/deepseek-v4.1-flash-1017@Wafer,z-ai/glm-5.3-flash
FAST_REASONING_EFFORT=none
# тяжёлый уровень — DeepSeek V4.1 Flash без рассуждений (замер 15.11, experiments/2026-11-15-models-architecture):
# бриф 25–26/36 против 22/36 у Inkling 2 Small, дешевле; с рассуждениями DeepSeek выдумывает вдвое чаще (ресерч)
HEAVY_MODEL=deepseek/deepseek-v4.1-flash@inference-net,deepseek/deepseek-v4.1-flash@Modal,z-ai/glm-5.3-flash
HEAVY_REASONING_EFFORT=none
ROUTE_FAST_MAX_CHARS=120
ROUTE_FAST_MIN_SCORE=0.7
# AGENT_MODEL используется, только если ROUTING_ENABLED=false
AGENT_MODEL=deepseek/deepseek-v4.1-flash@inference-net,deepseek/deepseek-v4.1-flash@Modal,z-ai/glm-5.3-flash
AGENT_REASONING_EFFORT=none
# реранкер: без GLM в цепочке — у него рассуждения всегда включены, p50 5–7 с на поиск (scripts/retrieval_bench.py)
RERANK_MODEL=deepseek/deepseek-v4.1-flash-1017@Baseten,deepseek/deepseek-v4.1-flash-1017@Wafer
CANDIDATE_K=12                      # кандидатов в реранкер: 12 — то же качество поиска, что 24, вдвое короче вход
RERANK_TIMEOUT_S=4                  # дольше — поиск отдаёт порядок гибридного слияния (без зависаний на 20–40 с)
RERANK_REASONING_EFFORT=none        # и для служебных вызовов (FAQ, классификация)
# флаги надёжности (Docs/latency-2026-11-15.md, «Подтверждение»); 0/false — выключить
LLM_STALL_TIMEOUT_S=10              # стрим молчит 10 с → сразу следующая модель цепочки
LLM_DEADLINE_CAP=true               # любой вызов обрезается по дедлайну хода, без хвостов в минуты
RETRIEVAL_DENSE_TIMEOUT_S=4         # эмбеддинг запроса не успел за 4 с × 2 → поиск только по BM25
RERANK_HEDGE_AFTER_S=1.5            # реранкер: через 1.5 с параллельно спрашиваем следующую модель цепочки
RETRIEVAL_SIBLINGS=true             # широкий вопрос: соседние подразделы того же раздела, совпадающие по словам вопроса
RETRIEVAL_SIBLING_CHUNKS=2          # сколько первых фрагментов брать из такого подраздела
AGENT_SEARCH_BEFORE_NO_FACTS=true   # вопрос по базе с «нет фактов»/уточнением без единого поиска → один повтор «сначала найди»
ANSWER_BRANCH_CHECK=true            # FR-GEN-06: вопрос об условиях + процитированная схема → назвать ≥ половины развилок
SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017@Wafer,z-ai/glm-5.3-flash
# картинки базы знаний (FR-ING-04): описание один раз при индексации, кэш по картинке + промпту + модели (data/vision_cache).
# Gemini 3.8 Flash + промпт v2 — 99 % пунктов эталона описаний (eval/golden/image_descriptions.yaml) против 91 % у прежнего кэша;
# схема процесса — все 20 переходов. ≈ $0,13 за всю базу (47 картинок)
VISION_MODEL=google/gemini-3.8-flash,qwen/qwen3.8-max-0902
VISION_PROMPT=v2
# vlm — только модель зрения; vlm+ocr — плюс дословные строки PP-OCRv5 (pip install .[ocr], файлы моделей в OCR_MODELS_DIR);
# ocr — без модели зрения. OCR на наших картинках добавил 1 пункт из 102 и путает «0» с кириллической «о» в номерах
VISION_MODE=vlm
# OCR_MODELS_DIR=
# VISION_CACHE_LEGACY=false         # true — брать старые описания (без модели в имени файла) любой моделью
USER_VISION_MODEL=thinkingmachines/inkling-2-small,z-ai/glm-5.3-flash  # скриншоты пользователя (FR-VIS-03)
TRANSCRIBE_MODEL=google/gemini-3.8-flash  # голосовые сообщения из бота (POST /transcribe); модели, принимающие аудио
LLM_MAX_TOKENS=4000                 # потолок ответа; без него OpenRouter резервирует 65k токенов
LLM_MAX_RETRIES=3
LLM_RPM=0                           # лимит запросов в минуту на модель (0 = без лимита)
VISION_WORKERS=3
ATTACH_CITED_IMAGES=true            # FR-VIS-02: ответ, опирающийся на описание картинки, приходит с самой картинкой

# --- эмбеддинги (смена модели = полная переиндексация). gemini-embedding-001 через OpenRouter: те же векторы, что у
# Gemini напрямую (косинус 1.0, scripts/compare_embeddings.py) → индекс Qdrant и кэш остаются; без суточной квоты free tier.
# Ключ и адрес берутся из OPENROUTER_API_KEY / OPENROUTER_BASE_URL, если EMBEDDING_API_KEY / EMBEDDING_BASE_URL пусты.
EMBEDDING_PROVIDER=openrouter       # openrouter | openai (любой совместимый API, в т.ч. Gemini напрямую) | fastembed (локально)
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536
EMBEDDING_ITEMS_PER_MIN=0
# Вариант: Gemini напрямую (бесплатный тариф — 1000 запросов в сутки, затем 429)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_API_KEY=<ключ Gemini API>
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_ITEMS_PER_MIN=90

# --- кэш частых вопросов по смыслу (FR-FAQ-01..08) ---
FAQ_ENABLED=true
FAQ_WINDOW_DAYS=14                  # окно анализа логов
FAQ_TOP_K=20                        # сколько популярных вопросов держать в кэше
FAQ_MATCH_THRESHOLD=0.84            # косинус кандидата; решают проверка сущностей и LLM-проверка
FAQ_CLUSTER_THRESHOLD=0.88
FAQ_VERIFY_LLM=true
FAQ_AUTO_TTL_S=604800               # TTL авто-ответа (7 дней)
FAQ_DISLIKE_THRESHOLD=3             # столько 👎 — запись выключается
FAQ_RECOMPUTE_INTERVAL_S=86400      # пересчёт топа раз в сутки (0 = только вручную, POST /faq/recompute)

# --- аналитика (FR-AN-04): классификация запросов по темам ---
CLASSIFY_ENABLED=true
CLASSIFY_INTERVAL_S=120
# Классификация и кластеры вопросов (Docs/questions.md): пересборка раз в час, user_ref от бота выключен
QUESTIONS_ENABLED=true
QUESTION_CLUSTER_INTERVAL_S=3600
QUESTION_USER_REF_ENABLED=false
ANSWER_CACHE_MAX_ENTRIES=2000
# пороги кластеров вопросов откалиброваны: eval/clustering/report.md
QUESTION_ASSIGN_THRESHOLD=0.82
QUESTION_CLUSTER_THRESHOLD=0.82
QUESTION_MERGE_THRESHOLD=0.86
QUESTION_ENTITY_GUARD=true
QUESTION_GAP_SHARE=0.5
ANSWER_CLUSTERS_ENABLED=false       # кластеры по ответам: FAQ-кандидаты, пробелы, слияния, согласованность (eval/clustering/answer_clusters.md)
ANSWER_CLUSTER_QUESTION_WEIGHT=0.7  # доля эмбеддинга вопроса; остальное — текст ответа и цитируемые разделы пополам
ANSWER_CLUSTER_THRESHOLD=0.84       # gemini-embedding-001, 2-fold CV на голденсете
QUESTION_MODEL_ENABLED=true          # обученный классификатор (analytics/qmodel.npz) поверх правил
QUESTION_MODEL_MIN_CONF=0.5
QUESTION_MODEL_TOPIC_CONF=0.5
QUESTION_SPIKE_Z=3
QUESTION_SPIKE_MIN=4
# Аналитика вопросов: запасной локальный эмбеддер (ONNX, CPU, в Docker-образе) при 429 / сбое основного; пороги
# кластеров для него свои (analytics/embedder.py: bge-m3 — 0.76 / 0.74 / 0.80). Поиск в Qdrant его не использует.
QUESTION_FALLBACK_EMBEDDER=   # BAAI/bge-m3 — локальный запасной эмбеддер (образ с --build-arg PRELOAD_FALLBACK_EMBEDDER=1)
QUESTION_FALLBACK_COOLDOWN_S=900
QUESTION_MODEL_UNSURE_CONF=0.7           # on_topic ниже этой уверенности решает LLM-классификатор (0 = выкл.)
# QUESTION_LLM_TOPIC_OVER_RULES=false     # модель не уверена в теме: тема по ключевым словам (false) или от LLM (true)
# CLASSIFY_PROMPT=v2                      # v1 — старый промпт LLM-классификатора
# QUESTION_LABEL_PROMPT=v2                # промпт названий кластеров
QUESTION_EMBED_TIMEOUT_S=8             # аналитика ждёт основной эмбеддер не дольше (на 32 текста), потом сразу bge-m3
# дневная сводка GET /analytics/daily-digest; автоотправка в конце дня выключена, пока DIGEST_WEBHOOK_URL пуст
QUESTION_DIGEST_TZ=Europe/Moscow
DIGEST_WEBHOOK_URL=
DIGEST_WEBHOOK_TOKEN=
LLM_PRICE_IN_PER_MTOK=0             # цена модели за 1M токенов для оценки стоимости
LLM_PRICE_OUT_PER_MTOK=0

# --- Git-репозиторий как источник (FR-GIT-*) ---
# токен репозитория кладётся сюда под любым именем, в источнике указывается только ИМЯ переменной (token_env)
# KB_GIT_TOKEN=<read-only токен GitHub/GitLab>
GIT_POLL_INTERVAL_S=0               # опрос без вебхука (сек), 0 = только вебхук / ручной sync
GIT_MAX_FILES=500
GIT_MAX_FILE_BYTES=5242880
# Сервис llm наружу не публикуется: ссылки на документы в ответах ведут через admin-сервис,
# который проксирует их сюда. PUBLIC_BASE_URL = <публичный адрес admin>/v1/public/rag
PUBLIC_BASE_URL=http://localhost:8000/v1/public/rag

# --- график дежурной смены поддержки (FR-ESC-05) ---
SUPPORT_HOURS=mon-fri 09:00-18:00
SUPPORT_TZ=Europe/Moscow

# --- токены API: без них все методы, кроме /health, отвечают 503 ---
# Единственный клиент сервиса — admin. Он ходит с ADMIN_API_TOKEN (подходит для всех методов);
# тот же токен задаётся в admin как RAG_API_TOKEN. SERVICE_API_TOKEN можно не задавать.
ADMIN_API_TOKEN=<случайная строка: python -c "import secrets;print(secrets.token_urlsafe(32))">
DOC_LINK_SECRET=<ещё одна случайная строка: ключ подписи ссылок на документы>
# AUTH_DISABLED=true          # только для локальной разработки

# --- Postgres: ходы с трейсом, оценки, задачи индексации (в compose задаётся автоматически) ---
POSTGRES_PASSWORD=rag
# DATABASE_URL=postgresql+pg8000://rag:rag@127.0.0.1:5432/rag   # без него — sqlite в var/rag.sqlite

# --- стоимость хода: OpenRouter сообщает её сам; для остальных — цена за 1 млн токенов [вход, выход] в USD по моделям ---
MODEL_PRICES=

# --- потоковая выдача ответа (NFR-01); false — ответ приходит целиком после проверки ---
AGENT_STREAMING=true
# false, если провайдер не принимает stream_options
LLM_STREAM_USAGE=true

# --- справочник продукта (сокращения, глоссарий); демо-база БАРС — config/product.demo-bars.yaml ---
PRODUCT_FILE=/app/config/product.yaml
BOT_NAME=Помощник
PRODUCT_NAME=вашей компании

# --- проекты создаёт admin, документы загружаются через панель: автоиндексации при старте нет ---
AUTO_INDEX_ON_START=false

# --- для запуска без docker (dev): локальные адреса сервисов; в compose задаются автоматически ---
# QDRANT_URL=http://127.0.0.1:6333
# REDIS_URL=redis://127.0.0.1:6379/0

# Фильтр входящих вопросов (rag_service/guard.py, Docs/guardrails.md)
GUARD_ENABLED=true
GUARD_MAX_CHARS=2000
GUARD_OFFTOPIC_CONF=0.97              # 0 = не блокировать нерелевантное
GUARD_LLM_ENABLED=true                # LLM только для сомнительных
# GUARD_ATTACK_MARGIN_DOUBT=-0.03       # полоса сомнения L2 → LLM (eval/guard/llm_layer.py)
# GUARD_LLM_MODEL=                    # пусто → CLASSIFY_MODEL → SUMMARY_MODEL

# Private adapter control service; use same CONTROL_TOKEN as adapter, never put it in frontend.
CONFLUENCE_CONTROL_URL=
CONFLUENCE_CONTROL_TOKEN=
CONFLUENCE_IMPORT_TIMEOUT_S=900
