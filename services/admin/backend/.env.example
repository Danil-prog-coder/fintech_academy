# --- admin: ядро платформы (открытый API /v1, сайт, эскалации и Jira) ---
# В docker compose DATABASE_URL и REDIS_URL задаются автоматически.
# DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/admin
# REDIS_URL=redis://localhost:6379/1

# Ключ шифрования кодов проектов, токенов Jira и секретов вебхуков (≥ 32 символов).
# Сменить его = потерять доступ к зашифрованным значениям. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<сгенерируйте>

# Скрытый RAG-сервис: адрес во внутренней сети и его ADMIN_API_TOKEN
RAG_URL=http://llm:8080
RAG_API_TOKEN=<тот же, что ADMIN_API_TOKEN в services/llm/.env>

# Публичные адреса: сайт (ссылки «задать пароль») и API (ссылки на документы в ответах).
# В compose сайт и API отдаются с одного домена.
PANEL_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
COOKIE_SECURE=false            # true за HTTPS

# Интеграции, создаваемые при старте: "slug:Название:ключ;…" (ключ ≥ 32 символов).
# Демо-почта ходит с этим ключом (MAIL: PLATFORM_API_KEY). Остальные — python -m admin_api.cli integration-create
BOOTSTRAP_INTEGRATIONS=mail-demo:Почта (демо):<случайная строка ≥ 32 символов>

# Вебхуки интеграций: в dev/compose можно слать во внутреннюю сеть
WEBHOOK_ALLOW_PRIVATE=false

# Лимиты
API_RATE_PER_MINUTE=600
LOGIN_ATTEMPTS=10
SESSION_TTL_HOURS=12
SETUP_LINK_TTL_HOURS=72
